   "source": [
    "lst = [1,2,3,4]\n",
    "rev =[]\n",
    "\n",
    "# len(lst) -> 4 - 1 =3\n",
    "# upto -1\n",
    "# go down 1\n",
    "for i in range (len(lst) - 1, -1, -1):\n",
    "    rev.append (lst[i])\n",
    "\n",
    "print (rev)"
